# ── Copy this file to .env and fill in real values ──────────────────────
# .env is git-ignored. NEVER commit real secrets.

# ── Spring Profile ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emras_db
DB_USERNAME=emras_user
DB_PASSWORD=emras_pass

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-very-long-random-string-at-least-256-bits

# ── AI ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Mail ─────────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend URL (for CORS) ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
